<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFF9F1">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recipes you can make"
        android:textColor="#29252F"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Based on the ingredients and quantities in your pantry."
        android:textColor="#625B71"
        android:textSize="15sp" />

    <ListView
        android:id="@+id/recipeListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:divider="#E5DFE9"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/emptyRecipesMessage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="No recipes match your pantry yet. Add more ingredients or quantities and check again."
        android:textColor="#625B71"
        android:textSize="16sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/backToPantryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Back to pantry" />

</LinearLayout>